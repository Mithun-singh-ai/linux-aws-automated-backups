#!/bin/bash

# Define variables
BACKUP_DIR="/tmp"
WEB_DIR="/var/www/html"
DATE=$(date +%Y-%m-%d_%H-%M-%S)
BACKUP_NAME="web-backup-$DATE.tar.gz"
S3_BUCKET="s3://s3-demo-bucket-m5"

echo "Starting backup process..."

# 1. Compress the website files into a .tar.gz archive
tar -czf $BACKUP_DIR/$BACKUP_NAME $WEB_DIR

# 2. Upload the archive to AWS S3 using the AWS CLI
aws s3 cp $BACKUP_DIR/$BACKUP_NAME $S3_BUCKET/

# 3. Clean up the local backup file from /tmp
rm $BACKUP_DIR/$BACKUP_NAME

echo "Backup completed and uploaded successfully to S3!"
